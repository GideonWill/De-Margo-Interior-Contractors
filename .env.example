# Environment Variables
# Copy this file to .env.local and fill in your actual values

# Firebase Configuration
# Get these from: Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Gemini AI (server-side only — NOT VITE_ prefixed)
# 1. Create a key at https://makersuite.google.com/app/apikey
# 2. For local dev: copy this file to .env.local and paste your key below
# 3. For production (Vercel): Project Settings → Environment Variables → GEMINI_API_KEY → Redeploy
GEMINI_API_KEY=your_gemini_api_key_here

# Paystack Configuration
# Get your public key from: Paystack Dashboard > Settings > API Keys & Webhooks
# Use TEST key for development, LIVE key for production
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_test_key_here
